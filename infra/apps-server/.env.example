# Copied to /opt/spotcraft/.env on the apps server.
PRIVATE_IP=10.0.0.2
SPOTCRAFT_TAG=latest
# openssl rand -hex 32; the ops server's dashboard uses the same value.
AGENT_TOKEN=change-me-to-64-hex-characters-0000000000000000000000000000000
# getent group docker | cut -d: -f3
DOCKER_GID=999
# openssl rand -hex 32; the agent's Postgres role (spotcraft_agent).
POSTGRES_AGENT_PASSWORD=change-me-to-64-hex-characters-000000000000000000000000000000
# Generated by the deploy script on the first deploy and kept; only used when Postgres
# creates its data directory.
POSTGRES_SUPERUSER_PASSWORD=change-me-to-64-hex-characters-000000000000000000000000000000
# Optional: every app is also served at <name>.<APPS_DOMAIN>. Point a wildcard record
# (*.apps.example.com) at this server. Leave empty to give each app its own domain only.
APPS_DOMAIN=
EDGE=direct
# Optional, with EDGE=cloudflare: the agent sets up custom domains' DNS (infra/cloudflare outputs).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_APPS_ZONE_ID=
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_ACCESS_POLICY_ID=
# Behind a Cloudflare Tunnel (EDGE=cloudflare, ADR 0021) the deploy adds:
# COMPOSE_PROFILES=cloudflare
# CLOUDFLARE_TUNNEL_TOKEN=...          # this server's tunnel (infra/cloudflare outputs)
# PUBLIC_BIND=127.0.0.1
# CADDY_TRUSTED_PROXIES=private_ranges
