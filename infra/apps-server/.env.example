# Copied to /opt/spotcraft/.env on the apps server.
PRIVATE_IP=10.0.0.2
SPOTCRAFT_TAG=latest
# openssl rand -hex 32; the ops server's dashboard uses the same value.
AGENT_TOKEN=change-me-to-64-hex-characters-0000000000000000000000000000000
# getent group docker | cut -d: -f3
DOCKER_GID=999
# openssl rand -hex 32; the agent's Postgres role (spotcraft_agent).
POSTGRES_AGENT_PASSWORD=change-me-to-64-hex-characters-000000000000000000000000000000
# Generated by the deploy script on the first deploy and kept; only used when Postgres
# creates its data directory.
POSTGRES_SUPERUSER_PASSWORD=change-me-to-64-hex-characters-000000000000000000000000000000
