# Caddy on the Spotcraft server: the dashboard at DASHBOARD_DOMAIN, and one site block per hosted
# app in sites/<app>.caddy (written by the agent). HTTPS is automatic (Let's Encrypt), or plain
# HTTP behind a Cloudflare Tunnel (DASHBOARD_SCHEME=http://; the agent writes http:// blocks),
# where Cloudflare holds the certificates.
{
	servers {
		# Behind a Cloudflare Tunnel (EDGE=cloudflare) requests come from cloudflared on a private
		# address and carry the visitor's address in CF-Connecting-IP; the deploy then sets
		# CADDY_TRUSTED_PROXIES=private_ranges. Otherwise only loopback is trusted, so a visitor
		# can't claim another address with the header (ADR 0021).
		trusted_proxies static {$CADDY_TRUSTED_PROXIES:127.0.0.1/32}
		client_ip_headers CF-Connecting-IP
		# Slow clients can't hold connections open.
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
	}
}

{$DASHBOARD_SCHEME}{$DASHBOARD_DOMAIN} {
	encode zstd gzip

	# The dashboard only takes forms (logins, app settings).
	request_body {
		max_size 1MB
	}

	# The dashboard sends its own CSP, X-Frame-Options and Cache-Control.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	reverse_proxy dashboard:3000 {
		# The dashboard's login lockout keys on this (XFF_DEPTH=1).
		header_up X-Forwarded-For {client_ip}
	}
}

import /etc/caddy/sites/*.caddy
