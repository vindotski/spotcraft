# Copy to terraform.tfvars (git-ignored). Give the API token through the environment:
#   export HCLOUD_TOKEN=...
deploy_ssh_public_key = "ssh-ed25519 AAAA... spotcraft-deploy"

# Optional:
# location          = "fsn1"
# apps_server_type  = "cax21"
# ops_server_type   = "cax11"
# ssh_source_ips    = ["203.0.113.4/32"]  # only if nothing else (e.g. GitHub Actions) needs SSH
# protect_servers   = true
# edge              = "cloudflare"   # close 80/443 once Cloudflare Tunnels carry the traffic
