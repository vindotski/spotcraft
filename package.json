{
  "name": "spotcraft",
  "version": "0.4.1",
  "description": "Self-hosted deployment for a handful of web apps on one server: Docker images behind HTTPS, monitored, managed from one dashboard.",
  "private": true,
  "license": "Apache-2.0",
  "author": "Ivan Vinski (https://www.vin.ski)",
  "homepage": "https://spotcraft.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vindotski/spotcraft.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive --if-present run test",
    "check": "biome check",
    "fix": "biome check --write",
    "verify": "pnpm check && pnpm check:versions && pnpm typecheck && pnpm test && pnpm build",
    "check:versions": "node scripts/check-versions.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@sveltejs/mcp": "^0.1.30",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
