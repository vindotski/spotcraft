{
  "name": "spotcraft",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive --if-present run test",
    "check": "biome check",
    "fix": "biome check --write",
    "verify": "pnpm check && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@sveltejs/mcp": "^0.1.30",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
