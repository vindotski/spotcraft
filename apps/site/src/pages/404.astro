---
import Base from '../layouts/Base.astro'
---

<Base title="Page not found · Spotcraft">
  <section class="mx-auto max-w-6xl px-4 py-24">
    <p class="font-mono text-sm text-muted-foreground">404</p>
    <h1 class="mt-2 font-heading text-3xl font-bold">Page not found</h1>
    <p class="mt-4 text-muted-foreground">
      This page doesn't exist. Try the <a href="/docs" class="underline underline-offset-4">docs</a
      > or the <a href="/" class="underline underline-offset-4">home page</a>.
    </p>
  </section>
</Base>
